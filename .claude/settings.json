{
  "permissions": {
    "allow": [
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(ls:*)",
      "Bash(uv sync)",
      "Bash(uv run python run_all.py:*)",
      "Bash(uv run python measures.py)",
      "Bash(uv run python hand_check.py:*)",
      "Bash(uv run python part1_independent.py:*)",
      "Bash(uv run python part2_recommender.py)",
      "Bash(uv run python part3_influence.py)",
      "Bash(uv run python part4_recommender.py)",
      "Bash(uv run python followup_shown.py)",
      "Bash(uv run python followup_assumption.py)",
      "Bash(uv run python dump_transcript.py)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); case \"$input\" in *commit*Part*) cd \"${CLAUDE_PROJECT_DIR:-.}\" 2>/dev/null; printf '%s' \"$input\" | uv run python commit_check.py; exit $? ;; esac; exit 0",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git fetch upstream --quiet 2>/dev/null; git log --oneline HEAD..upstream/main 2>/dev/null; uv run python dump_transcript.py >/dev/null 2>&1; exit 0",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run python dump_transcript.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
